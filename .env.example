# PostgreSQL Connection String
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/doctor_db?schema=public"

# Authentication & Session Secrets
JWT_SECRET="replace-with-a-random-32-byte-hex-or-base64-secret"
AUTH_SECRET="replace-with-another-secure-secret-key"

# Private Storage Configuration (local or s3)
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./storage/prescriptions"

# Optional S3-compatible storage configuration:
# S3_ENDPOINT="https://s3.ap-south-1.amazonaws.com"
# S3_REGION="ap-south-1"
# S3_BUCKET="doctor-prescriptions-vault"
# S3_ACCESS_KEY_ID="your-access-key"
# S3_SECRET_ACCESS_KEY="your-secret-key"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Node Environment
NODE_ENV="development"
